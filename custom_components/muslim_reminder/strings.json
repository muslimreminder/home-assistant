  "services": {
    "play_salawat": {
      "name": "Play a salawat reminder",
      "description": "Plays a salawat reminder (prayer upon the Prophet ﷺ) now, whatever the switches and the conditions.",
      "fields": {
        "config_entry_id": {
          "name": "Place",
          "description": "The Muslim Reminder place (needed when there are several)."
        },
        "entity_id": {
          "name": "Speakers",
          "description": "Media players to play on (default: those of the options)."
        },
        "sound": {
          "name": "Sound",
          "description": "Default: the one selected."
        },
        "volume": {
          "name": "Volume",
          "description": "Volume in percent (default: the one set; 0 leaves the volume as it is)."
        }
      }
    },
    "play_adhan": {
      "name": "Play the adhan",
      "description": "Plays the adhan now, whatever the switches and the conditions.",
      "fields": {
        "config_entry_id": {
          "name": "Place",
          "description": "The Muslim Reminder place (needed when there are several)."
        },
        "entity_id": {
          "name": "Speakers",
          "description": "Media players to play on (default: those of the options)."
        },
        "sound": {
          "name": "Sound",
          "description": "Default: the one selected."
        },
        "full": {
          "name": "Full adhan",
          "description": "Off: the short version (30 s)."
        },
        "volume": {
          "name": "Volume",
          "description": "Volume in percent (default: the one set; 0 leaves the volume as it is)."
        }
      }
    },
    "get_prayer_times": {
      "name": "Get prayer times",
      "description": "Returns the prayer times of a day.",
      "fields": {
        "config_entry_id": {
          "name": "Place",
          "description": "The Muslim Reminder place (needed when there are several)."
        },
        "date": {
          "name": "Date",
          "description": "Default: today."
        }
      }
    }
  },
